{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == 'Bash' && tool_input.command matches 'git push.*--force'",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCKED: Force push not allowed' && exit 1"
          }
        ]
      }
    ]
  }
}
