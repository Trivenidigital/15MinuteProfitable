# === Wallet Authentication ===
# Private key and funder are stored in the encrypted vault (AES-256-GCM).
# See .vault-password.env for vault config. Do NOT put private keys here.
BOT_SIGNATURE_TYPE=1
# 0 = EOA (MetaMask, hardware wallet)
# 1 = Magic.link (Polymarket email login) - requires funder in vault
# 2 = Gnosis Safe

# === Trading Parameters ===
BOT_ORDER_SIZE=50
BOT_ORDER_TYPE=FOK
BOT_TARGET_PAIR_COST=0.94
BOT_MIN_PROFIT_MARGIN=0.005
BOT_COOLDOWN_SECONDS=5

# === Strategy Toggles ===
BOT_ENABLE_ARBITRAGE=true
BOT_ENABLE_ASYMMETRIC=false
BOT_ENABLE_PRICE_LAG=false
BOT_ENABLE_MULTI_MARKET=true
BOT_MARKETS=BTC,ETH,SOL,XRP

# === Risk Limits (USD) ===
BOT_MAX_POSITION_PER_MARKET=500
BOT_MAX_TOTAL_POSITION=2000
BOT_MAX_DAILY_LOSS=50
BOT_MAX_UNHEDGED_EXPOSURE=100

# === Simulation Mode ===
BOT_DRY_RUN=true
BOT_SIM_BALANCE=1000

# === Alerts (optional) ===
BOT_TELEGRAM_BOT_TOKEN=
BOT_TELEGRAM_CHAT_ID=
BOT_DISCORD_WEBHOOK_URL=

# === Logging ===
BOT_LOG_LEVEL=INFO
BOT_LOG_FORMAT=json
