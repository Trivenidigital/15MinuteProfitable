[Unit]
Description=BTC 15-Minute Bot Admin Dashboard (HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/btc15minutebot
EnvironmentFile=/opt/btc15minutebot/.env
EnvironmentFile=-/opt/btc15minutebot/.admin.env
ExecStart=/opt/btc15minutebot/.venv/bin/python -m src.admin
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillSignal=SIGTERM
StandardOutput=append:/var/log/btc15minutebot/admin.log
StandardError=append:/var/log/btc15minutebot/admin-error.log

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/btc15minutebot /var/log/btc15minutebot
PrivateTmp=true

[Install]
WantedBy=multi-user.target
