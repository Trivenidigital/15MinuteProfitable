[Unit]
Description=BTC 15-Minute Polymarket Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/btc15minutebot
EnvironmentFile=/opt/btc15minutebot/.env
ExecStart=/opt/btc15minutebot/.venv/bin/python -m src.main
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=append:/var/log/btc15minutebot/bot.log
StandardError=append:/var/log/btc15minutebot/error.log

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/btc15minutebot /var/log/btc15minutebot
PrivateTmp=true

[Install]
WantedBy=multi-user.target
